# copy to .env (never commit the real one)
COMFY_CLOUD_KEY=

# optional, defaults shown
#STUDIO_DATA_DIR=./data                    # library/, pipelines/, oneoffs/, logs/, audio/ (start from data.example/)
#LOCAL_COMFY_URL=http://127.0.0.1:8188
#COMFYUI_SERVICE=comfyui.service           # systemd --user unit the UI's restart button restarts
#COMFYUI_MODELS_DIR=~/comfy/ComfyUI/models  # the local ComfyUI models/ folder (hashed for Civitai metadata)
#FILE_MANAGER=xdg-open                     # "reveal in folder" command; the path is appended (e.g. "dolphin --select")
#DEFAULT_BEATS=audio/default.json          # the beat file an edit uses when a project picks none (in STUDIO_DATA_DIR)
#VOICE_SAMPLES_PROJECT=voice_samples       # the project holding one sample clip per voice (Voices page)
#PUBLISH_DIR=/path/to/copy/finished/edits  # unset = finished edits are not copied anywhere
#PUSHOVER_USER=                           # Pushover user key (or set it in the web UI: ⚙ Settings, which wins over these)
#PUSHOVER_TOKEN=                          # Pushover app token (or put it in .pushover_token)

# RunPod animate target (optional; ⚙ Settings → animate target)
#RUNPOD_API_KEY=
#RUNPOD_VOLUME_ID=                         # the network volume runpod/seed.py filled
#RUNPOD_DATACENTER=                        # where that volume lives, e.g. EU-RO-1
#RUNPOD_H3_UNET=                           # a finetuned H3 UNet on the volume instead of the stock one ("" = stock)
#RUNPOD_IDLE_MINUTES=2
