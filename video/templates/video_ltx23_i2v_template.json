{
  "ltx:ckpt": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sulphur2Base_distilled.safetensors"}, "_meta": {"title": "Load Checkpoint (Sulphur 2 / LTX 2.3)"}},
  "ltx:te": {"class_type": "LTXAVTextEncoderLoader", "inputs": {"text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors", "ckpt_name": "sulphur2Base_distilled.safetensors", "device": "default"}, "_meta": {"title": "LTXV Audio Text Encoder Loader"}},
  "ltx:audio_vae": {"class_type": "LTXVAudioVAELoader", "inputs": {"ckpt_name": "sulphur2Base_distilled.safetensors"}, "_meta": {"title": "LTXV Audio VAE Loader"}},
  "ltx:image": {"class_type": "LoadImage", "inputs": {"image": "PLACEHOLDER_UPLOADED_FILENAME.png"}, "_meta": {"title": "Load Image"}},
  "ltx:size": {"class_type": "ResolutionSelector", "inputs": {"aspect_ratio": "2:3 (Portrait Photo)", "megapixels": 0.6, "multiple": 32}, "_meta": {"title": "Resolution Selector"}},
  "ltx:resize": {"class_type": "ResizeImageMaskNode", "inputs": {"input": ["ltx:image", 0], "resize_type": "scale dimensions", "resize_type.width": ["ltx:size", 0], "resize_type.height": ["ltx:size", 1], "resize_type.crop": "center", "scale_method": "lanczos"}, "_meta": {"title": "Resize Image"}},
  "ltx:preprocess": {"class_type": "LTXVPreprocess", "inputs": {"image": ["ltx:resize", 0], "img_compression": 18}, "_meta": {"title": "LTXVPreprocess"}},
  "ltx:length": {"class_type": "PrimitiveInt", "inputs": {"value": 49}, "_meta": {"title": "Int (frames, 8k+1)"}},
  "ltx:latent": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": ["ltx:size", 0], "height": ["ltx:size", 1], "length": ["ltx:length", 0], "batch_size": 1}, "_meta": {"title": "EmptyLTXVLatentVideo"}},
  "ltx:i2v": {"class_type": "LTXVImgToVideoInplace", "inputs": {"vae": ["ltx:ckpt", 2], "image": ["ltx:preprocess", 0], "latent": ["ltx:latent", 0], "strength": 1.0, "bypass": false}, "_meta": {"title": "LTXVImgToVideoInplace"}},
  "ltx:audio_latent": {"class_type": "LTXVEmptyLatentAudio", "inputs": {"frames_number": ["ltx:length", 0], "frame_rate": 24, "batch_size": 1, "audio_vae": ["ltx:audio_vae", 0]}, "_meta": {"title": "LTXV Empty Latent Audio"}},
  "ltx:av": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["ltx:i2v", 0], "audio_latent": ["ltx:audio_latent", 0]}, "_meta": {"title": "LTXVConcatAVLatent"}},
  "ltx:prompt": {"class_type": "CLIPTextEncode", "inputs": {"text": "PLACEHOLDER_PROMPT", "clip": ["ltx:te", 0]}, "_meta": {"title": "CLIP Text Encode (Prompt)"}},
  "ltx:negative": {"class_type": "CLIPTextEncode", "inputs": {"text": "pc game, console game, video game, cartoon, childish, ugly", "clip": ["ltx:te", 0]}, "_meta": {"title": "CLIP Text Encode (Negative)"}},
  "ltx:cond": {"class_type": "LTXVConditioning", "inputs": {"positive": ["ltx:prompt", 0], "negative": ["ltx:negative", 0], "frame_rate": 24}, "_meta": {"title": "LTXVConditioning"}},
  "ltx:guider": {"class_type": "CFGGuider", "inputs": {"model": ["ltx:ckpt", 0], "positive": ["ltx:cond", 0], "negative": ["ltx:cond", 1], "cfg": 1}, "_meta": {"title": "CFGGuider"}},
  "ltx:sampler": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}, "_meta": {"title": "KSamplerSelect"}},
  "ltx:sigmas": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}, "_meta": {"title": "ManualSigmas (distilled 8 steps)"}},
  "ltx:seed": {"class_type": "RandomNoise", "inputs": {"noise_seed": 0}, "_meta": {"title": "RandomNoise"}},
  "ltx:sample": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["ltx:seed", 0], "guider": ["ltx:guider", 0], "sampler": ["ltx:sampler", 0], "sigmas": ["ltx:sigmas", 0], "latent_image": ["ltx:av", 0]}, "_meta": {"title": "SamplerCustomAdvanced"}},
  "ltx:split": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["ltx:sample", 0]}, "_meta": {"title": "LTXVSeparateAVLatent"}},
  "ltx:decode": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["ltx:split", 0], "vae": ["ltx:ckpt", 2], "tile_size": 768, "overlap": 64, "temporal_size": 4096, "temporal_overlap": 4}, "_meta": {"title": "VAE Decode (Tiled)"}},
  "ltx:audio_decode": {"class_type": "LTXVAudioVAEDecode", "inputs": {"samples": ["ltx:split", 1], "audio_vae": ["ltx:audio_vae", 0]}, "_meta": {"title": "LTXV Audio VAE Decode"}},
  "ltx:video": {"class_type": "CreateVideo", "inputs": {"fps": 24, "bit_depth": 8, "color_space": "sRGB", "codec": "none", "images": ["ltx:decode", 0], "audio": ["ltx:audio_decode", 0]}, "_meta": {"title": "Create Video"}},
  "ltx:save": {"class_type": "SaveVideo", "inputs": {"filename_prefix": "video/LTX23", "format": "auto", "format.codec": "auto", "codec": "auto", "video": ["ltx:video", 0]}, "_meta": {"title": "Save Video"}}
}
